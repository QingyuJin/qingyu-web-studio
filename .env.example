# Browser-safe Supabase values. The publishable key is expected to be public.
NEXT_PUBLIC_SUPABASE_URL=https://project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=replace-with-publishable-key
NEXT_PUBLIC_API_URL=http://localhost:4000

# Server-only API values. Never prefix the service-role key with NEXT_PUBLIC_.
SUPABASE_URL=https://project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=replace-with-publishable-key
SUPABASE_SERVICE_ROLE_KEY=replace-in-secret-manager
WEB_ORIGIN=http://localhost:3000
PORT=4000
LOG_LEVEL=info
